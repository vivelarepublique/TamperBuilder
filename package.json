{
    "name": "tamper-builder",
    "version": "0.0.0",
    "description": "A Vite-powered Tampermonkey userscript example using Vue, React, Preact, Lit, Svelte, and Solid.",
    "main": "./src/index.ts",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:primitive": "vite build --mode primitive",
        "build:minify": "vite build --mode minify",
        "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.react.json && tsc --noEmit -p tsconfig.preact.json && tsc --noEmit -p tsconfig.lit.json && tsc --noEmit -p tsconfig.solid.json && tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.vue.json && svelte-check --tsconfig ./tsconfig.svelte.json",
        "test": "vitest run",
        "verify:output": "node scripts/verify-build-output.mjs",
        "verify:native-config": "node scripts/verify-native-config-loader.mjs",
        "verify:frameworks": "node scripts/verify-framework-selection.mjs",
        "verify:builds": "node scripts/verify-builds.mjs",
        "check": "npm audit --audit-level=high && npm run typecheck && npm test && npm run verify:native-config && npm run verify:frameworks && npm run verify:builds"
    },
    "keywords": [
        "react",
        "vue",
        "preact",
        "lit",
        "svelte",
        "solid",
        "tampermonkey",
        "vite",
        "typescript"
    ],
    "author": "vivelarepublique",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "packageManager": "npm@11.19.0",
    "dependencies": {
        "@lit/context": "^1.1.6",
        "@preact/signals": "^2.11.1",
        "lit": "^3.3.3",
        "pinia": "^4.0.3",
        "preact": "^10.29.8",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "solid-js": "^1.9.15",
        "vue": "^3.5.41",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@preact/preset-vite": "^2.10.6",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/tampermonkey": "^5.0.5",
        "@types/web": "^0.0.354",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "fast-xml-parser": "^5.11.0",
        "jsdom": "30.1.2",
        "less": "^4.9.0",
        "node-fetch": "^3.3.2",
        "sass": "^1.102.0",
        "stylus": "^0.64.0",
        "svelte": "^5.56.9",
        "svelte-check": "4.7.6",
        "terser": "^5.50.0",
        "typescript": "^6.0.3",
        "vite": "^8.2.1",
        "vite-plugin-solid": "^2.11.14",
        "vitest": "5.0.4",
        "vue-tsc": "3.3.13",
        "yaml": "^2.9.0"
    }
}
