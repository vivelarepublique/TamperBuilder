{
    "name": "tamper-builder",
    "version": "0.0.0",
    "description": "A Vite-powered Tampermonkey userscript example using Vue, React, Preact, Lit, Svelte, and Solid.",
    "main": "./src/index.ts",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:primitive": "vite build --mode primitive",
        "build:minify": "vite build --mode minify",
        "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.react.json && tsc --noEmit -p tsconfig.preact.json && tsc --noEmit -p tsconfig.lit.json && tsc --noEmit -p tsconfig.solid.json && tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.vue.json && svelte-check --tsconfig ./tsconfig.svelte.json",
        "test": "vitest run",
        "lint": "eslint . --max-warnings 0",
        "verify:output": "node scripts/verify-build-output.mjs",
        "verify:native-config": "node scripts/verify-native-config-loader.mjs",
        "verify:frameworks": "node scripts/verify-framework-selection.mjs",
        "verify:builds": "node scripts/verify-builds.mjs",
        "check": "npm audit --audit-level=high && npm run lint && npm run typecheck && npm test && npm run verify:native-config && npm run verify:frameworks && npm run verify:builds"
    },
    "keywords": [
        "react",
        "vue",
        "preact",
        "lit",
        "svelte",
        "solid",
        "tampermonkey",
        "vite",
        "typescript"
    ],
    "author": "vivelarepublique",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "packageManager": "npm@11.19.0",
    "dependencies": {
        "@lit/context": "1.1.6",
        "@preact/signals": "2.11.3",
        "lit": "3.3.3",
        "pinia": "4.0.3",
        "preact": "10.29.8",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "solid-js": "1.9.17",
        "vue": "3.5.44",
        "zustand": "5.0.15"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@preact/preset-vite": "2.10.6",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@types/tampermonkey": "5.5.0",
        "@types/web": "0.0.354",
        "@vitejs/plugin-react": "5.2.0",
        "@vitejs/plugin-vue": "6.0.10",
        "eslint": "9.39.5",
        "eslint-plugin-lit": "2.3.1",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-solid": "0.18.1",
        "eslint-plugin-svelte": "3.23.1",
        "eslint-plugin-vue": "10.11.1",
        "fast-xml-parser": "5.11.2",
        "globals": "17.13.0",
        "jsdom": "30.1.2",
        "less": "4.9.1",
        "node-fetch": "3.3.2",
        "sass": "1.105.1",
        "stylus": "0.64.0",
        "svelte": "5.57.2",
        "svelte-check": "4.7.6",
        "terser": "5.51.2",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.2",
        "vite": "8.3.4",
        "vite-plugin-solid": "2.11.14",
        "vitest": "5.0.4",
        "vue-eslint-parser": "10.4.1",
        "vue-tsc": "3.3.13",
        "yaml": "2.9.1"
    }
}
